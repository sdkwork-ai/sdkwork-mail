{
  "schemaVersion": 5,
  "kind": "sdkwork.app.topology",
  "appId": "sdkwork-mail",
  "applicationCode": "mail",
  "archetype": "application-http-gateway",
  "profileRoot": "etc/topology",
  "profilePattern": "{deploymentProfile}.{environment}.env",
  "vocabulary": {
    "environment": {
      "allowed": [
        "development",
        "test",
        "staging",
        "production"
      ]
    },
    "connectivityPlane": {
      "allowed": [
        "application",
        "platform",
        "operations"
      ]
    },
    "deploymentProfile": {
      "allowed": [
        "standalone",
        "cloud"
      ]
    }
  },
  "defaults": {
    "developmentProfileId": "standalone.development",
    "productionProfileId": "cloud.production",
    "desktopBuildProfileId": "standalone.production",
    "gatewayBind": "127.0.0.1:3900"
  },
  "profileFiles": {
    "standalone.development": "etc/topology/standalone.development.env",
    "standalone.test": "etc/topology/standalone.test.env",
    "standalone.staging": "etc/topology/standalone.staging.env",
    "standalone.production": "etc/topology/standalone.production.env",
    "cloud.development": "etc/topology/cloud.development.env",
    "cloud.test": "etc/topology/cloud.test.env",
    "cloud.staging": "etc/topology/cloud.staging.env",
    "cloud.production": "etc/topology/cloud.production.env"
  },
  "envKeys": {
    "environment": "sdkwork_mail_ENVIRONMENT",
    "profileId": "sdkwork_mail_PROFILE_ID",
    "standaloneGatewayBind": "sdkwork_mail_APPLICATION_PUBLIC_INGRESS_BIND",
    "clientApiGatewayBaseUrl": "VITE_sdkwork_mail_PC_PLATFORM_API_GATEWAY_HTTP_URL",
    "apiGatewayBaseUrl": "sdkwork_mail_PLATFORM_API_GATEWAY_HTTP_URL",
    "deploymentProfile": "sdkwork_mail_DEPLOYMENT_PROFILE",
    "clientDeploymentProfile": "VITE_sdkwork_mail_PC_DEPLOYMENT_PROFILE"
  },
  "surfaces": {
    "application.public-ingress": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "sdkwork_mail_APPLICATION_PUBLIC_INGRESS_BIND",
      "httpUrlEnv": "sdkwork_mail_APPLICATION_PUBLIC_HTTP_URL",
      "clientHttpEnv": "VITE_sdkwork_mail_PC_APPLICATION_PUBLIC_HTTP_URL"
    },
    "platform.api-gateway": {
      "connectivityPlane": "platform",
      "protocols": [
        "http"
      ],
      "httpUrlEnv": "sdkwork_mail_PLATFORM_API_GATEWAY_HTTP_URL",
      "clientHttpEnv": "VITE_sdkwork_mail_PC_PLATFORM_API_GATEWAY_HTTP_URL"
    }
  },
  "cloudPublicHosts": {
    "application.public-ingress": {
      "httpHost": "mail.sdkwork.com",
      "environments": {
        "development": {
          "httpHosts": [
            "mail-dev.sdkwork.com",
            "mail-dev.birdcoder.com",
            "mail-dev.dtupay.com",
            "mail-dev.sdkwork.cn",
            "mail-dev.birdcoder.cn",
            "mail-dev.dtupay.cn"
          ]
        },
        "test": {
          "httpHosts": [
            "mail-test.sdkwork.com",
            "mail-test.birdcoder.com",
            "mail-test.dtupay.com",
            "mail-test.sdkwork.cn",
            "mail-test.birdcoder.cn",
            "mail-test.dtupay.cn"
          ]
        },
        "staging": {
          "httpHosts": [
            "mail-staging.sdkwork.com",
            "mail-staging.birdcoder.com",
            "mail-staging.dtupay.com",
            "mail-staging.sdkwork.cn",
            "mail-staging.birdcoder.cn",
            "mail-staging.dtupay.cn"
          ]
        }
      },
      "httpHosts": [
        "mail.sdkwork.com",
        "mail.birdcoder.com",
        "mail.dtupay.com",
        "mail.sdkwork.cn",
        "mail.birdcoder.cn",
        "mail.dtupay.cn"
      ]
    },
    "platform.api-gateway": {
      "httpHost": "api.sdkwork.com",
      "environments": {
        "development": {
          "httpHosts": [
            "api-dev.sdkwork.com",
            "api-dev.birdcoder.com",
            "api-dev.dtupay.com",
            "api-dev.sdkwork.cn",
            "api-dev.birdcoder.cn",
            "api-dev.dtupay.cn"
          ]
        },
        "test": {
          "httpHosts": [
            "api-test.sdkwork.com",
            "api-test.birdcoder.com",
            "api-test.dtupay.com",
            "api-test.sdkwork.cn",
            "api-test.birdcoder.cn",
            "api-test.dtupay.cn"
          ]
        },
        "staging": {
          "httpHosts": [
            "api-staging.sdkwork.com",
            "api-staging.birdcoder.com",
            "api-staging.dtupay.com",
            "api-staging.sdkwork.cn",
            "api-staging.birdcoder.cn",
            "api-staging.dtupay.cn"
          ]
        }
      },
      "httpHosts": [
        "api.sdkwork.com",
        "api.birdcoder.com",
        "api.dtupay.com",
        "api.sdkwork.cn",
        "api.birdcoder.cn",
        "api.dtupay.cn"
      ]
    }
  },
  "components": {
    "applicationApiServer": {
      "crate": "sdkwork-api-mail-standalone-gateway",
      "binary": "sdkwork-api-mail-standalone-gateway"
    }
  },
  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-mail-standalone-gateway",
            "binary": "sdkwork-api-mail-standalone-gateway",
            "required": true,
            "role": "api-standalone-gateway"
          },
          {
            "id": "mail-browser",
            "role": "client",
            "applicationRoot": "apps/sdkwork-mail-pc",
            "bindEnv": "SDKWORK_MAIL_WEB_DEV_INGRESS_BIND",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "required": true
          }
        ],
        "capabilitySubset": [
          "application-http"
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ],
        "browserDeliveries": [
          {
            "id": "mail-adaptive-web",
            "applicationRoot": "apps/sdkwork-mail-pc",
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "originMode": "same-origin",
            "deliveryMode": "dev-server-proxy",
            "clientProcessId": "mail-browser",
            "apiSurfaceId": "application.public-ingress",
            "preserveCanonicalPaths": true,
            "tabletArchitecture": "pc-web",
            "renderers": {
              "pc-web": {
                "applicationRoot": "apps/sdkwork-mail-pc",
                "script": "dev",
                "defaultPort": 4501,
                "portEnv": "SDKWORK_MAIL_PC_INTERNAL_DEV_PORT",
                "env": {}
              },
              "h5": {
                "applicationRoot": "apps/sdkwork-mail-h5",
                "script": "dev",
                "defaultPort": 4502,
                "portEnv": "SDKWORK_MAIL_H5_INTERNAL_DEV_PORT",
                "env": {}
              }
            }
          }
        ]
      },
      "cloud.development": {
        "processes": [
          {
            "id": "mail-browser",
            "role": "client",
            "applicationRoot": "apps/sdkwork-mail-pc",
            "bindEnv": "SDKWORK_MAIL_WEB_DEV_INGRESS_BIND",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "required": true
          }
        ],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ],
        "browserDeliveries": [
          {
            "id": "mail-adaptive-web",
            "applicationRoot": "apps/sdkwork-mail-pc",
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "originMode": "same-origin",
            "deliveryMode": "dev-server-proxy",
            "clientProcessId": "mail-browser",
            "apiSurfaceId": "application.public-ingress",
            "preserveCanonicalPaths": true,
            "tabletArchitecture": "pc-web",
            "renderers": {
              "pc-web": {
                "applicationRoot": "apps/sdkwork-mail-pc",
                "script": "dev",
                "defaultPort": 4501,
                "portEnv": "SDKWORK_MAIL_PC_INTERNAL_DEV_PORT",
                "env": {}
              },
              "h5": {
                "applicationRoot": "apps/sdkwork-mail-h5",
                "script": "dev",
                "defaultPort": 4502,
                "portEnv": "SDKWORK_MAIL_H5_INTERNAL_DEV_PORT",
                "env": {}
              }
            }
          }
        ]
      },
      "cloud.production": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-mail-standalone-gateway",
            "binary": "sdkwork-api-mail-standalone-gateway",
            "required": true,
            "role": "api-standalone-gateway"
          },
          {
            "id": "pc-renderer",
            "package": "apps/sdkwork-mail-pc",
            "script": "dev",
            "required": false,
            "role": "client"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "standalone.production": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-mail-standalone-gateway",
            "binary": "sdkwork-api-mail-standalone-gateway",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "capabilitySubset": [
          "application-http"
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "standalone.test": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-mail-standalone-gateway",
            "binary": "sdkwork-api-mail-standalone-gateway",
            "required": true,
            "role": "api-standalone-gateway"
          },
          {
            "id": "mail-browser",
            "role": "client",
            "applicationRoot": "apps/sdkwork-mail-pc",
            "bindEnv": "SDKWORK_MAIL_WEB_DEV_INGRESS_BIND",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "required": true
          }
        ],
        "capabilitySubset": [
          "application-http"
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ],
        "browserDeliveries": [
          {
            "id": "mail-adaptive-web",
            "applicationRoot": "apps/sdkwork-mail-pc",
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "originMode": "same-origin",
            "deliveryMode": "dev-server-proxy",
            "clientProcessId": "mail-browser",
            "apiSurfaceId": "application.public-ingress",
            "preserveCanonicalPaths": true,
            "tabletArchitecture": "pc-web",
            "renderers": {
              "pc-web": {
                "applicationRoot": "apps/sdkwork-mail-pc",
                "script": "dev",
                "defaultPort": 4501,
                "portEnv": "SDKWORK_MAIL_PC_INTERNAL_DEV_PORT",
                "env": {}
              },
              "h5": {
                "applicationRoot": "apps/sdkwork-mail-h5",
                "script": "dev",
                "defaultPort": 4502,
                "portEnv": "SDKWORK_MAIL_H5_INTERNAL_DEV_PORT",
                "env": {}
              }
            }
          }
        ]
      },
      "standalone.staging": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-mail-standalone-gateway",
            "binary": "sdkwork-api-mail-standalone-gateway",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "capabilitySubset": [
          "application-http"
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "cloud.test": {
        "processes": [
          {
            "id": "mail-browser",
            "role": "client",
            "applicationRoot": "apps/sdkwork-mail-pc",
            "bindEnv": "SDKWORK_MAIL_WEB_DEV_INGRESS_BIND",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "required": true
          }
        ],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ],
        "browserDeliveries": [
          {
            "id": "mail-adaptive-web",
            "applicationRoot": "apps/sdkwork-mail-pc",
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "originMode": "same-origin",
            "deliveryMode": "dev-server-proxy",
            "clientProcessId": "mail-browser",
            "apiSurfaceId": "application.public-ingress",
            "preserveCanonicalPaths": true,
            "tabletArchitecture": "pc-web",
            "renderers": {
              "pc-web": {
                "applicationRoot": "apps/sdkwork-mail-pc",
                "script": "dev",
                "defaultPort": 4501,
                "portEnv": "SDKWORK_MAIL_PC_INTERNAL_DEV_PORT",
                "env": {}
              },
              "h5": {
                "applicationRoot": "apps/sdkwork-mail-h5",
                "script": "dev",
                "defaultPort": 4502,
                "portEnv": "SDKWORK_MAIL_H5_INTERNAL_DEV_PORT",
                "env": {}
              }
            }
          }
        ]
      },
      "cloud.staging": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-mail-standalone-gateway",
            "binary": "sdkwork-api-mail-standalone-gateway",
            "required": true,
            "role": "api-standalone-gateway"
          },
          {
            "id": "pc-renderer",
            "package": "apps/sdkwork-mail-pc",
            "script": "dev",
            "required": false,
            "role": "client"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      }
    }
  },
  "packaging": {
    "cloudConfigFiles": [],
    "targets": [
      {
        "id": "platform-config-bundle-tar-gz",
        "profile": "platform-config-bundle",
        "platform": "all",
        "architecture": "all",
        "formats": [
          "tar.gz"
        ],
        "runner": "ubuntu-24.04",
        "outputGlob": "dist/cloud-config/sdkwork-mail-api-gateway-config-*.tar.gz"
      }
    ]
  },
  "scripts": {
    "mailDev": "scripts/mail-dev.mjs"
  },
  "retired": {
    "vocabulary": {
      "topology": [
        "standalone",
        "cloud"
      ],
      "hosting": [
        "self-hosted",
        "cloud-hosted"
      ]
    },
    "envKeys": [
      "sdkwork_mail_API_BIND",
      "VITE_mail_API_BASE_URL",
      "VITE_mail_BACKEND_API_BASE_URL",
      "sdkwork_mail_HOSTING",
      "VITE_sdkwork_mail_PC_HOSTING"
    ]
  }
}
