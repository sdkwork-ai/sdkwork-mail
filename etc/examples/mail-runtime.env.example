# Safe Mail runtime defaults for local development and tests.
# Topology bind: see etc/topology/*.env and specs/topology.spec.json.
SDKWORK_MAIL_APP_CONTEXT_REQUIRE_SIGNATURE=false
SDKWORK_MAIL_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:18090
# Mail server persistence uses the canonical workspace PostgreSQL profile.
SDKWORK_DATABASE_URL=postgresql://sdkwork_ai_dev:sdkworkdev123@127.0.0.1:5432/sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
# SDKWORK_MAIL_HYDRATE_TENANT_ID=100001
# SDKWORK_MAIL_HYDRATE_ORGANIZATION_ID=0

# IMAP transport plugin (optional)
# SDKWORK_MAIL_IMAP_HOST=imap.example.com
# SDKWORK_MAIL_IMAP_PORT=993
# SDKWORK_MAIL_IMAP_USE_TLS=true
# SDKWORK_MAIL_IMAP_USERNAME=user@example.com
# SDKWORK_MAIL_IMAP_PASSWORD=replace-me
# SDKWORK_MAIL_IMAP_MAILBOX=INBOX

# SMTP transport plugin (optional)
# SDKWORK_MAIL_TRANSPORT_MODE=log
# SDKWORK_MAIL_SMTP_HOST=smtp.example.com
# SDKWORK_MAIL_SMTP_PORT=587
# SDKWORK_MAIL_SMTP_USE_TLS=true
# SDKWORK_MAIL_SMTP_USERNAME=noreply@example.com
# SDKWORK_MAIL_SMTP_PASSWORD=replace-me
# SDKWORK_MAIL_SMTP_FROM_EMAIL=noreply@example.com

# Drive attachment validation (optional; production recommended)
# When set, Mail validates attachment driveNodeId references via Drive facade.
# In cloud dev topology, route through platform API gateway (see etc/topology/*.env).
# SDKWORK_DRIVE_FACADE_URL=http://127.0.0.1:3900
# SDKWORK_AUTH_TOKEN=replace-me
# SDKWORK_ACCESS_TOKEN=replace-me
