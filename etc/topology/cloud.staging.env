# Bootstrap profile cloud.staging — replace with application-specific values.
SDKWORK_MAIL_DEPLOYMENT_PROFILE=cloud
SDKWORK_MAIL_ENVIRONMENT=staging
SDKWORK_MAIL_PROFILE_ID=cloud.staging
SDKWORK_MAIL_APPLICATION_PUBLIC_HTTP_URL=https://mail-staging.sdkwork.com
SDKWORK_MAIL_PLATFORM_API_GATEWAY_HTTP_URL=https://api-staging.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MAIL_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

