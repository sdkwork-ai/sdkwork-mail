# cloud.production
sdkwork_mail_DEPLOYMENT_PROFILE=cloud
sdkwork_mail_ENVIRONMENT=production
sdkwork_mail_PROFILE_ID=cloud.production

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MAIL_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_MAIL_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:18090
SDKWORK_MAIL_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18090

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=db.example.com
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_prod
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_prod
SDKWORK_DATABASE_USERNAME=sdkwork_ai_prod
SDKWORK_DATABASE_PASSWORD_FILE=/run/secrets/sdkwork/database-password
SDKWORK_DATABASE_SSL_MODE=require
sdkwork_mail_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:18090
sdkwork_mail_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18090
sdkwork_mail_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
sdkwork_mail_PLATFORM_API_GATEWAY_AUTOSTART=true

# Canonical profile identity (SOURCE_CONFIG_SPEC.md)
SDKWORK_MAIL_ENVIRONMENT=production
SDKWORK_MAIL_DEPLOYMENT_PROFILE=cloud
SDKWORK_MAIL_PROFILE_ID=cloud.production
SDKWORK_CORS_ALLOWED_ORIGINS=https://mail.sdkwork.com,https://mail.birdcoder.com,https://mail.dtupay.com,https://mail.noaper.com,https://mail.sdkwork.cn,https://mail.birdcoder.cn,https://mail.dtupay.cn,https://mail.noaper.cn,https://mail.skubc.com,https://mail.skubc.cn,https://mail.zowalk.com,https://mail.zowalk.cn,https://mail.offer86.com,https://mail.offer86.cn,https://mail.86offer.com,https://mail.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
