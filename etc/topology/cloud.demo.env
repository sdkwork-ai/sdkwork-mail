# Bootstrap profile cloud.demo — cloud independent demonstration deployment.
SDKWORK_MAIL_DEPLOYMENT_PROFILE=cloud
SDKWORK_MAIL_ENVIRONMENT=demo
SDKWORK_MAIL_PROFILE_ID=cloud.demo
SDKWORK_MAIL_APPLICATION_PUBLIC_HTTP_URL=https://mail-demo.sdkwork.com
SDKWORK_MAIL_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
SDKWORK_MAIL_WEB_DEV_INGRESS_BIND=127.0.0.1:4499
SDKWORK_MAIL_PC_INTERNAL_DEV_PORT=4501
SDKWORK_MAIL_H5_INTERNAL_DEV_PORT=4502


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MAIL_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
