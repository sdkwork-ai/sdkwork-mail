# cloud.development
sdkwork_mail_DEPLOYMENT_PROFILE=cloud
sdkwork_mail_ENVIRONMENT=development
sdkwork_mail_PROFILE_ID=cloud.development

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MAIL_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_MAIL_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:18090
SDKWORK_MAIL_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18090

SDKWORK_DATABASE_URL=postgresql://sdkwork_ai_dev:sdkworkdev123@127.0.0.1:5432/sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
sdkwork_mail_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:18090
sdkwork_mail_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
sdkwork_mail_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
sdkwork_mail_PLATFORM_API_GATEWAY_AUTOSTART=false

VITE_sdkwork_mail_PC_DEPLOYMENT_PROFILE=cloud
VITE_sdkwork_mail_PC_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
VITE_sdkwork_mail_PC_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
VITE_sdkwork_mail_H5_DEPLOYMENT_PROFILE=cloud
VITE_sdkwork_mail_H5_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18090
VITE_sdkwork_mail_H5_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
SDKWORK_MAIL_WEB_DEV_INGRESS_BIND=127.0.0.1:4499
SDKWORK_MAIL_PC_INTERNAL_DEV_PORT=4501
SDKWORK_MAIL_H5_INTERNAL_DEV_PORT=4502

# Canonical profile identity (SOURCE_CONFIG_SPEC.md)
SDKWORK_MAIL_ENVIRONMENT=development
SDKWORK_MAIL_DEPLOYMENT_PROFILE=cloud
SDKWORK_MAIL_PROFILE_ID=cloud.development

# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
