# Bootstrap profile cloud.test — replace with application-specific values.
SDKWORK_MAIL_DEPLOYMENT_PROFILE=cloud
SDKWORK_MAIL_ENVIRONMENT=test
SDKWORK_MAIL_PROFILE_ID=cloud.test
SDKWORK_MAIL_APPLICATION_PUBLIC_HTTP_URL=https://mail-test.sdkwork.com
SDKWORK_MAIL_PLATFORM_API_GATEWAY_HTTP_URL=https://api-test.sdkwork.com
